# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Public URL of the site (used for canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://injmakeup.com

# PostgreSQL connection string — REQUIRED in production for booking/contact/course enquiries.
# Without it, production forms show "temporarily unavailable" and nothing is saved.
# In local development, if unset, enquiries are written to .data/enquiries.json instead.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Only if your provider uses a self-signed certificate:
# DATABASE_SSL_NO_VERIFY=true

# Admin inbox at /admin — both are required to enable sign-in.
ADMIN_PASSWORD=choose-a-long-unique-password
# At least 32 random characters, e.g. generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Optional: email the studio when an enquiry arrives (https://resend.com).
# The sending domain must be verified in Resend.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=injmakeupstudio@gmail.com
NOTIFY_EMAIL_FROM=INJ Website <enquiries@injmakeup.com>

# Optional: show draft Beauty Journal articles on a preview deployment. Keep unset/false in production.
SHOW_DRAFT_ARTICLES=false
